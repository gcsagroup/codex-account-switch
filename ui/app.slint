    in-out property <string> tr-turns: "轮次";
    in-out property <string> tr-returned-total: "已返回项目合计";
    in-out property <string> tr-plugins: "插件";
    in-out property <string> tr-skills: "技能";
    in-out property <string> tr-analysis-delay: "用量为近似值，最多可能延迟 6 小时。每日用量不等于当前窗口的已用比例。";
    in-out property <string> tr-analysis-source: "官方账号统计 · 工具榜单为每日返回项目汇总；Token 活动独立展示。";

    // i18n text properties
    in-out property <string> tr-app-title: "Codex Account Switch";
    in-out property <string> tr-tray-refresh: "Refresh Usage";
    in-out property <string> tr-tray-switch: "Switch Account";
    in-out property <string> tr-tray-quit: "Quit";
    in-out property <string> tr-btn-about: "About";
    in-out property <string> tr-about-description: "A local GCSA utility for saving and switching Codex and Claude Desktop account profiles, viewing Codex usage, reset times, and activity insights.";
    in-out property <string> tr-about-third-party: "THIRD-PARTY SOFTWARE";
    in-out property <string> tr-about-notices: "Slint attribution is required by its royalty-free license. Other dependency licenses and source URLs are included in THIRD_PARTY_NOTICES.md with the app.";
    in-out property <string> tr-about-close: "Close";
    in-out property <string> tr-btn-restore: "Restore Last";
    in-out property <string> tr-btn-refresh-usage: "Refresh Usage";
    in-out property <string> tr-btn-refresh-list: "Refresh List";
    in-out property <string> tr-btn-quit: "Quit";
    in-out property <string> tr-active-title: "ACTIVE";
    in-out property <string> tr-detail-title: "ACCOUNT DETAILS";
    in-out property <string> tr-active-no-account: "No account selected";
    in-out property <string> tr-active-hint: "Save or switch an account to see identity";
    in-out property <string> tr-active-restart-hint: "Restart Codex after switching to take effect";
    in-out property <string> tr-token-title: "TOKEN ACTIVITY";
    in-out property <string> tr-token-lifetime: "Lifetime";
    in-out property <string> tr-token-peak: "Peak day";
    in-out property <string> tr-token-streak: "Streak";
    in-out property <string> tr-token-longest: "Longest";
    in-out property <string> tr-token-last-seven: "LAST 7 DAYS";
    in-out property <string> tr-activity-open: "Activity Insights";
    in-out property <string> tr-activity-title: "Activity Insights";
    in-out property <string> tr-activity-subtitle: "Current Codex account";
    in-out property <string> tr-activity-back: "Back to accounts";
    in-out property <string> tr-activity-daily: "Daily";
    in-out property <string> tr-activity-weekly: "Weekly";
    in-out property <string> tr-activity-cumulative: "Cumulative";
    in-out property <string> tr-activity-longest-streak: "Longest streak";
    in-out property <string> tr-activity-chart-title: "TOKEN ACTIVITY";
    in-out property <string> tr-activity-chart-hint: "Past 52 weeks";
    in-out property <string> tr-activity-insights: "ACTIVITY INSIGHTS";
    in-out property <string> tr-activity-fast-mode: "Fast mode";
    in-out property <string> tr-activity-reasoning: "Most used reasoning";
    in-out property <string> tr-activity-unique-skills: "Skills explored";
    in-out property <string> tr-activity-total-skills: "Total skill uses";
    in-out property <string> tr-activity-threads: "Total chats";
    in-out property <string> tr-activity-top: "MOST USED PLUGINS & SKILLS";
    in-out property <string> tr-activity-runs: "runs";
    in-out property <string> tr-activity-no-data: "Refresh usage to load activity data";
    in-out property <string> tr-import-tab-login: "Browser Login";
    in-out property <string> tr-import-tab-save: "Save Current";
    in-out property <string> tr-import-tab-path: "From Path";
    in-out property <string> tr-import-tab-paste: "Paste JSON";
    in-out property <string> tr-login-hint: "Sign in with ChatGPT OAuth; the profile is saved automatically after completion";
    in-out property <string> tr-login-alias-placeholder: "Optional alias, defaults to email prefix";
    in-out property <string> tr-login-open: "Open Browser to Login";
    in-out property <string> tr-login-running: "Logging in…";
    in-out property <string> tr-login-cancel: "Cancel";
    in-out property <string> tr-save-alias-placeholder: "Alias, e.g. work";
    in-out property <string> tr-save-button: "Save Current";
    in-out property <string> tr-save-import: "Import Current";
    in-out property <string> tr-path-placeholder: "Paste full directory path to open…";
    in-out property <string> tr-path-open: "Open Directory…";
    in-out property <string> tr-paste-placeholder: "Paste full auth.json content here (supports ```json blocks)…";
    in-out property <string> tr-paste-alias-placeholder: "Optional alias, defaults to email prefix";
    in-out property <string> tr-paste-import: "Import from Paste";
    in-out property <string> tr-paste-clipboard: "From Clipboard";
    in-out property <string> tr-rename-title: "Rename";
    in-out property <string> tr-rename-new-placeholder: "New alias";
    in-out property <string> tr-rename-confirm: "Confirm";
    in-out property <string> tr-rename-cancel: "Cancel";
    in-out property <string> tr-profiles-title: "PROFILES";
    in-out property <string> tr-profiles-empty: "No saved accounts yet";
    in-out property <string> tr-profiles-empty-hint: "Use \"Save Current\" or import auth.json from path";
    in-out property <string> tr-profiles-count: "saved";
    in-out property <string> tr-btn-switch: "Switch";
    in-out property <string> tr-btn-restart: "Restart";
    in-out property <string> tr-btn-rename: "Rename";
    in-out property <string> tr-btn-delete: "Delete";
    in-out property <string> tr-label-in-use: "IN USE";
    in-out property <string> tr-label-preview: "PREVIEW";
    in-out property <string> tr-label-no-email: "No email";
    in-out property <string> tr-label-invalid: "INVALID";
    in-out property <string> tr-gauge-5h: "5H WINDOW";
    in-out property <string> tr-gauge-weekly: "WEEKLY";
    in-out property <string> tr-usage-reset: "Reset";
    in-out property <string> tr-claude-session-hint: "Switching restarts Claude Desktop automatically";
    in-out property <string> tr-claude-login-hint: "Open Claude Desktop, sign in, then use Save Current";
    in-out property <string> tr-claude-paste-placeholder: "";
    in-out property <string> tr-claude-open: "Open Claude Desktop";

    callback refresh();
    callback save-current();
    callback import-auth();
    callback import-live();
    callback import-paste();
    callback import-clipboard();
    callback login-browser();
    callback cancel-login();
    callback begin-rename(string);
    callback confirm-rename();
    callback cancel-rename();

    in-out property <int> import-tab: 0;
    callback use-account(string);
    callback use-account-restart(string);
    callback preview-account(string);
    callback remove-account(string);
    callback restore-account();
    callback refresh-usage();
    callback quit();

    VerticalBox {
        padding: 0px;
        spacing: 0px;
        Rectangle {
            height: 48px;
            background: Theme.panel;
            HorizontalBox {
                padding-left: 22px; padding-right: 18px; spacing: 14px;
                Text { text: "Codex Account Switch  ·  " + app-version; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                ComboBox { width: 140px; horizontal-stretch: 0; model: ["English", "简体中文", "繁體中文", "日本語", "한국어", "Français", "Español"]; current-index <=> root.lang-index; selected(value) => { root.set-language(self.current-index); } }
                GhostButton { label: tr-btn-about; clicked => { show-about = true; } }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalBox {
            spacing: 0px;
            Rectangle {
                width: 166px;
                background: Theme.panel;
                VerticalBox {
                    padding: 14px; padding-top: 28px; spacing: 10px;
                    Text { text: "Account Switch"; color: Theme.copper; font-size: 14px; font-weight: 600; }
                    Rectangle { height: 16px; }
                    Text { text: "CODEX"; color: Theme.faint; font-size: 10px; }
                    GhostButton { label: tr-nav-accounts; solid: provider-index == 0 && page-index == 0; horizontal-stretch: 1; btn-height: 38px; clicked => { page-index = 0; if provider-index != 0 { root.set-provider(0); } } }
                    GhostButton { label: tr-nav-analysis; solid: provider-index == 0 && page-index == 1; horizontal-stretch: 1; btn-height: 38px; clicked => { if provider-index != 0 { root.set-provider(0); } page-index = 1; root.load-analysis(false); } }
                    Rectangle { height: 14px; }
                    GhostButton { label: "Claude Desktop"; solid: provider-index == 1; horizontal-stretch: 1; btn-height: 38px; clicked => { page-index = 0; root.set-provider(1); } }
                    Rectangle { vertical-stretch: 1; }
                    GhostButton { label: tr-gcsa-products + " ↗"; horizontal-stretch: 1; clicked => { root.open-gcsa-link(false); } }
                    GhostButton { label: "GitHub ↗"; horizontal-stretch: 1; clicked => { root.open-gcsa-link(true); } }
                    GhostButton { label: tr-network; horizontal-stretch: 1; clicked => { show-network = !show-network; } }
                    GhostButton { label: tr-btn-quit; horizontal-stretch: 1; clicked => { quit(); } }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            content-scroll := ScrollView {
                horizontal-stretch: 1;
                VerticalBox {
                    padding: 22px; spacing: 16px;
                    if show-network: Rectangle {
                        height: 126px; border-radius: 10px; background: Theme.elevated;
                        VerticalBox {
                            padding: 16px; spacing: 8px;
                            Text { text: tr-network; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: tr-network-hint; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            HorizontalBox {
                                Text { text: status-text; color: Theme.muted; font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                GhostButton { label: tr-btn-refresh-usage; enabled: !usage-busy; clicked => { root.refresh-usage(); } }
                            }
                        }
                    }
                    if page-index == 0: VerticalBox {
                        spacing: 12px;
                        HorizontalBox {
                            VerticalBox { spacing: 4px; horizontal-stretch: 1;
                                Text { text: provider-index == 0 ? tr-nav-accounts : "Claude Desktop"; font-size: 25px; font-weight: 600; color: Theme.text; }
                                Text { text: accounts.length + " " + tr-profiles-count + (active-alias == "" ? "" : " · " + tr-label-in-use + "  " + active-alias); font-size: 12px; color: Theme.muted; overflow: elide; }
                            }
                            GhostButton { label: workspace-text[1]; clicked => { root.import-all(); } }
                            GhostButton { label: workspace-text[2]; clicked => { root.export-all(); } }
                            GhostButton { label: show-add ? tr-about-close : tr-add-account; emphasis: !show-add; clicked => { show-add = !show-add; } }
                        }
                        if show-add || rename-from != "": Rectangle {
                    // Content height differs by mode. Rename is a focused
                    // state that replaces the import form inside this card.
                    height: rename-from != ""
                        ? 124px
                        : (import-tab == 3
                            ? 196px
                            : (import-tab == 0 ? 148px : 124px));
                    vertical-stretch: 0;
                    border-radius: 14px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line.with-alpha(0.78);

                    VerticalBox {
                        padding: 12px;
                        spacing: 8px;

                        // Import method tabs
                        HorizontalBox {
                            spacing: 6px;
                            for tab[idx] in [tr-import-tab-login, tr-import-tab-save, tr-import-tab-path, tr-import-tab-paste]: GhostButton {
                                visible: provider-index == 0 || idx < 2;
                                label: provider-index == 1 && idx == 0 ? "Claude Desktop" : tab;
                                solid: import-tab == idx;
                                horizontal-stretch: 1;
                                btn-height: 32px;
                                clicked => { import-tab = idx; }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.line; }

                        // Browser login
                        if rename-from == "" && import-tab == 0: VerticalBox {
                            spacing: 8px;
                            Text {
                                text: provider-index == 0
                                    ? tr-login-hint
                                    : tr-claude-login-hint;
                                font-size: 11px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            HorizontalBox {
                                spacing: 8px;
                                Field {
                                    visible: provider-index == 0;
                                    text <=> login-alias;
                                    placeholder: tr-login-alias-placeholder;
                                    horizontal-stretch: 1;
                                    accepted => { login-browser(); }
                                }
                                GhostButton {
                                    label: provider-index == 1
                                        ? tr-claude-open
                                        : (login-running ? tr-login-running : tr-login-open);
                                    emphasis: true;
                                    enabled: !login-running;
                                    clicked => { login-browser(); }
                                }
                                if provider-index == 0 && login-running: GhostButton {
                                    label: tr-login-cancel;
                                    solid: true;
                                    clicked => { cancel-login(); }
                                }
                            }
                        }

                        // Save current
                        if rename-from == "" && import-tab == 1: HorizontalBox {
                            spacing: 8px;
                            Field {
                                text <=> save-alias;
                                placeholder: tr-save-alias-placeholder;
                                horizontal-stretch: 1;
                                accepted => { save-current(); }
                            }
                            GhostButton {
                                label: tr-save-button;
                                emphasis: true;
                                clicked => { save-current(); }
                            }
                            GhostButton {
                                label: tr-save-import;
                                clicked => { import-live(); }
                            }
                        }

                        // From path
                        if rename-from == "" && import-tab == 2: HorizontalBox {
                            spacing: 8px;
                            Field {
                                text <=> browse-path;
                                placeholder: tr-path-placeholder;
                                horizontal-stretch: 1;
                                accepted => { import-auth(); }
                            }
                            GhostButton {
                                label: tr-path-open;
                                clicked => { import-auth(); }
                            }
                        }

                        // Paste text
                        if rename-from == "" && import-tab == 3: VerticalBox {
                            spacing: 8px;
                            TextArea {
                                text <=> paste-json;
                                placeholder: provider-index == 0
                                    ? tr-paste-placeholder
                                    : tr-claude-paste-placeholder;
                                area-height: 88px;
                            }
                            HorizontalBox {
                                spacing: 8px;
                                Field {
                                    text <=> paste-alias;
                                    placeholder: tr-paste-alias-placeholder;
                                    horizontal-stretch: 1;
                                    accepted => { import-paste(); }
                                }
                                GhostButton {
                                    label: tr-paste-import;
                                    emphasis: true;
                                    clicked => { import-paste(); }
                                }
                                GhostButton {
                                    label: tr-paste-clipboard;
                                    solid: true;
                                    clicked => { import-clipboard(); }
                                }
                            }
                        }

                        if rename-from != "": HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: tr-rename-title;
                                font-size: 11px;
                                font-family: "Menlo";
                                color: Theme.copper;
                                vertical-alignment: center;
                            }
                            Text {
                                text: rename-from;
                                font-size: 11px;
                                font-family: "Menlo";
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "→";
                                font-size: 11px;
                                color: Theme.faint;
                                vertical-alignment: center;
                            }
                            Field {
                                text <=> rename-to;
                                placeholder: tr-rename-new-placeholder;
                                horizontal-stretch: 1;
                                accepted => { confirm-rename(); }
                            }
                            GhostButton {
                                label: tr-rename-confirm;
                                emphasis: true;
                                clicked => { confirm-rename(); }
                            }
                            GhostButton {
                                label: tr-rename-cancel;
                                clicked => { cancel-rename(); }
                            }
                        }
                    }
                }
                        HorizontalBox {
                            Field { text <=> root.account-query; placeholder: workspace-text[0]; horizontal-stretch: 1; edited => { root.filter-accounts(); } }
                            if account-query != "": GhostButton { label: workspace-text[13]; clicked => { account-query = ""; root.filter-accounts(); } }
                            GhostButton { label: tr-btn-refresh-list; clicked => { root.refresh(); } }
                            if provider-index == 0: GhostButton { label: usage-busy ? tr-loading : tr-btn-refresh-usage; enabled: !usage-busy; clicked => { root.refresh-usage(); } }
                        }
                        if provider-index == 0 && account-order-summary != "": VerticalBox { spacing: 7px;
                            Text { text: account-order-summary; font-size: 13px; color: Theme.text; wrap: word-wrap; }
                            Text { text: account-order-rule; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                        }
                        if accounts.length == 0: Text { text: tr-profiles-empty + "\n" + tr-profiles-empty-hint; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        if accounts.length > 0 && visible-accounts.length == 0: Text { text: workspace-text[14]; color: Theme.muted; font-size: 13px; }
                        for acc in root.visible-accounts: account-row := Rectangle {
                            private property <bool> expanded: false;
                            private property <bool> history-open: false;
                            changed details => { if !self.details { self.history-open = false; } }
                            private property <bool> details: root.expanded-account == acc.alias && root.current-alias == acc.alias;
                            vertical-stretch: 0;
                            background: Theme.panel;
                            border-radius: 10px;
                            border-width: 1px; border-color: acc.is_current ? Theme.copper.with-alpha(0.7) : details ? Theme.copper.with-alpha(0.45) : Theme.line;
                            TouchArea {
                                x: 0px; y: 0px; height: 64px; width: parent.width - 330px;
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: root.tr-detail-title + " · " + acc.alias;
                                clicked => {
                                    if root.expanded-account == acc.alias { root.expanded-account = ""; }
                                    else { root.expanded-account = acc.alias; root.preview-account(acc.alias); }
                                }
                            }
                            VerticalBox { padding: 14px; spacing: 8px;
                                HorizontalBox { spacing: 10px; min-height: 40px;
                                    VerticalBox { spacing: 4px; horizontal-stretch: 1;
                                        Text { text: acc.alias + "  " + acc.plan + (acc.is_current ? " · " + tr-label-in-use : ""); font-size: 14px; font-weight: 600; color: Theme.text; overflow: elide; }
                                        Text { text: acc.email; font-size: 11px; color: Theme.muted; overflow: elide; }
                                    }
                                    if provider-index == 0: VerticalBox { width: 180px; horizontal-stretch: 0; spacing: 6px; alignment: center;
                                        Text { text: (acc.secondary_available ? tr-weekly-remaining + " " + Math.round(Math.max(0, Math.min(100, 100 - acc.secondary_pct))) + "%" : acc.usage_summary != "" ? acc.usage_summary : tr-weekly-remaining + " —") + (acc.quota-stale ? " · " + tr-cached : ""); font-size: 11px; color: acc.usage_attention ? Theme.copper : Theme.text; wrap: word-wrap; }
                                        Rectangle { height: 4px; border-radius: 2px; background: Theme.line;
                                            Rectangle { x: 0px; y: 0px; width: parent.width * Math.min(1, Math.max(0, 1 - acc.secondary_pct / 100)); height: parent.height; border-radius: 2px; background: acc.quota-stale ? Theme.muted : acc.secondary_pct >= 90 ? Theme.copper : Theme.ok; visible: acc.secondary_available; }
                                        }
                                        Text { text: tr-credits-balance + " " + acc.credits; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                    }
                                    GhostButton { label: tr-detail-title + (account-row.details ? " ▴" : " ▾"); solid: account-row.details; clicked => { if account-row.details { root.expanded-account = ""; } else { root.expanded-account = acc.alias; root.preview-account(acc.alias); } } }
                                    GhostButton { label: tr-more; solid: account-row.expanded; clicked => { account-row.expanded = !account-row.expanded; } }
                                }
                                HorizontalBox { spacing: 10px;
                                    VerticalBox { horizontal-stretch: 1; spacing: 4px;
                                        if provider-index == 0: Text { text: acc.reset_summary; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                                        if provider-index == 0: Text { text: acc.recommendation; font-size: 11px; color: Theme.copper; wrap: word-wrap; }
                                        if provider-index == 1: Text { text: tr-claude-session-hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                    }
                                    if provider-index == 0: GhostButton { label: tr-nav-analysis; clicked => { root.preview-account(acc.alias); page-index = 1; root.load-analysis(false); } }
                                    GhostButton { label: acc.is_current ? tr-label-in-use : tr-btn-switch; emphasis: !acc.is_current; enabled: acc.is_valid && !acc.is_current; clicked => { root.use-account(acc.alias); } }
                                }
                                if account-row.details: VerticalBox {
                                    spacing: 14px;
                                    Rectangle { height: 1px; background: Theme.line; }
                                    if provider-index == 0: HorizontalBox {
                                        spacing: 24px;
                                        VerticalBox { spacing: 5px; horizontal-stretch: 2;
                                            Text { text: tr-weekly-remaining + (acc.quota-stale ? " · " + tr-cached : ""); color: Theme.muted; font-size: 12px; }
                                            Text { text: current-secondary-available ? Math.round(Math.max(0, Math.min(100, 100 - current-secondary))) + "%" : "—"; font-size: 26px; font-weight: 600; color: Theme.text; }
                                            Rectangle { height: 6px; border-radius: 3px; background: Theme.line;
                                                Rectangle { x: 0px; y: 0px; width: parent.width * Math.min(1,Math.max(0,1 - current-secondary / 100)); height: parent.height; border-radius: 3px; background: acc.quota-stale ? Theme.muted : current-secondary >= 90 ? Theme.copper : Theme.ok; visible: current-secondary-available; }
                                            }
                                            Text { text: current-secondary-reset; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                        }
                                        VerticalBox { spacing: 5px; horizontal-stretch: 1;
                                            Text { text: tr-gauge-5h; font-size: 12px; color: Theme.muted; }
                                            if current-primary-available: Text { text: Math.round(current-primary) + "%"; font-size: 26px; color: Theme.text; font-weight: 600; }
                                            Text { text: current-primary-reset; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                        }
                                        VerticalBox { spacing: 9px; horizontal-stretch: 1;
                                            Text { text: current-reset-credits; font-size: 12px; color: Theme.copper; wrap: word-wrap; }
                                            GhostButton { label: tr-reset-history; clicked => { account-row.history-open = !account-row.history-open; if account-row.history-open { root.load-reset-history(false); } } }
                                            Text { text: tr-credits-balance + " " + current-credits; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                                        }
                                    }
                                    if provider-index == 0: Text { text: acc.quota-details; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                    if provider-index == 0: VerticalBox { spacing: 8px;
                                        Rectangle { height: 1px; background: Theme.line; }
                                        HorizontalBox { spacing: 24px;
                                            VerticalBox { spacing: 4px;
                                                Text { text: weekly-token-title; color: Theme.muted; font-size: 12px; }
                                                Text { text: weekly-tokens; color: Theme.text; font-size: 22px; font-weight: 600; }
                                            }
                                            VerticalBox { spacing: 4px;
                                                Text { text: weekly-value-title; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                                Text { text: weekly-value; color: Theme.copper; font-size: 22px; font-weight: 600; }
                                            }
                                        }
                                        Text { text: weekly-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    }
                                    if provider-index == 0 && account-row.history-open: VerticalBox { spacing: 10px;
                                        Rectangle { height: 1px; background: Theme.line; }
                                        HorizontalBox {
                                            Text { text: tr-reset-history + " · " + reset-history-window; font-size: 13px; color: Theme.text; horizontal-stretch: 1; }
                                            GhostButton { label: reset-history-busy ? tr-loading : tr-reset-history + " ↻"; enabled: !reset-history-busy; clicked => { root.load-reset-history(true); } }
                                        }
                                        Text { text: reset-history-status; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                        for event in reset-history-rows: VerticalBox { spacing: 8px;
                                            HorizontalBox {
                                                Text { text: event.title; color: Theme.text; font-size: 12px; horizontal-stretch: 1; }
                                                Text { text: event.time; color: Theme.muted; font-size: 11px; }
                                            }
                                            Rectangle { height: 1px; background: Theme.line; }
                                        }
                                    }
                                    Text { text: provider-index == 0 ? current-usage-stamp : tr-claude-session-hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                }
                                if provider-index == 0 && !account-row.details: Text { text: (acc.usage_error != "" ? tr-cached + " · " : "") + acc.usage_updated; font-size: 11px; color: Theme.muted; }
                                if provider-index == 0 && acc.usage_error != "": Text { text: acc.usage_error; font-size: 11px; color: Theme.copper; wrap: word-wrap; }
                                if account-row.expanded: HorizontalBox { spacing: 8px;
                                    GhostButton { label: tr-btn-restart; enabled: acc.is_valid; clicked => { root.use-account-restart(acc.alias); } }
                                    GhostButton { label: tr-btn-rename; clicked => { show-add = true; root.begin-rename(acc.alias); } }
                                    GhostButton { label: tr-btn-delete; danger: true; clicked => { root.remove-account(acc.alias); } }
                                }
                            }
                        }
                        HorizontalBox {
                            Text { text: tr-active-restart-hint; color: Theme.muted; font-size: 11px; horizontal-stretch: 1; wrap: word-wrap; visible: provider-index == 0; }
                            GhostButton { label: tr-btn-restore; enabled: can-restore; clicked => { root.restore-account(); } }
                        }
                    }
                    if page-index == 1 && provider-index == 0: VerticalBox {
                        spacing: 16px;
                        PageHeader {
                            heading: "Codex · 分析";
                            subtitle: analysis-local-mode ? "本机项目与聊天 · 与云端账号统计独立" : current-alias + " · " + current-plan;
                            ComboBox { width: 90px; model: ["7 天", "30 天"]; current-index <=> root.analysis-range;
                                selected(value) => { analysis-detail = ""; root.load-analysis(false); root.local-page = 0; root.render-local-analysis(); } }
                            GhostButton { label: analysis-local-mode ? (local-busy ? "读取中" : "刷新本机") : (analysis-busy ? "读取中" : "刷新统计");
                                enabled: analysis-local-mode ? !local-busy : !analysis-busy && current-alias != "";
                                clicked => { if analysis-local-mode { root.load-local-analysis(); } else { root.load-analysis(true); root.refresh-usage(); } } }
                        }
                        HorizontalBox { spacing: 10px;
                            GhostButton { label: "账号分析"; solid: !analysis-local-mode; clicked => { analysis-local-mode = false; } }
                            GhostButton { label: "本机项目 / 聊天"; solid: analysis-local-mode; clicked => { analysis-local-mode = true; root.load-local-analysis(); } }
                            Rectangle { horizontal-stretch: 1; }
                            GhostButton { label: "导出 CSV"; clicked => { if analysis-local-mode { root.export-local-analysis(); } else { root.export-analysis(); } } }
                        }
                        ComboBox { model: root.analysis-accounts; current-index <=> root.analysis-account-index;
                            enabled: root.accounts.length > 0;
                            selected(value) => { if self.current-index >= 0 && self.current-index < root.accounts.length {
                                root.preview-account(root.accounts[self.current-index].alias); analysis-detail = ""; root.load-analysis(false); root.local-page = 0; root.render-local-analysis();
                            } }
                        }
                        if !analysis-local-mode: VerticalBox { spacing: 16px;
                            Text { text: "账号期间指标 · " + analysis-date-range; color: Theme.text; font-size: 13px; }
                            if root.width >= 1000px: VerticalBox { spacing: 10px;
                                HorizontalBox { spacing: 10px;
                                    ActivityMetric { value: val-total; label: "已返回日期 Token · 账号总量"; }
                                    ActivityMetric { value: analysis-turn-total; label: "已返回对话轮次 · 非完成任务数"; }
                                }
                                HorizontalBox { spacing: 10px;
                                    ActivityMetric { value: analysis-consumption; label: "期间日消耗合计 · 非当前窗口额度"; }
                                    ActivityMetric { value: analysis-dominant; label: "主要消耗模型 · 按已返回明细"; }
                                }
                            }
                            if root.width < 1000px: VerticalBox { spacing: 10px;
                                ActivityMetric { value: val-total; label: "已返回日期 Token · 账号总量"; }
                                ActivityMetric { value: analysis-turn-total; label: "已返回对话轮次 · 非完成任务数"; }
                                ActivityMetric { value: analysis-consumption; label: "期间日消耗合计 · 非当前窗口额度"; }
                                ActivityMetric { value: analysis-dominant; label: "主要消耗模型 · 按已返回明细"; }
                            }
                            Text { text: analysis-coverage; color: Theme.copper; font-size: 12px; wrap: word-wrap; }
                            Text { text: val-coverage; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                            if analysis-status != "": Text { text: analysis-status; color: Theme.copper; font-size: 12px; wrap: word-wrap; }
                            if analysis-action-status != "": Text { text: analysis-action-status; color: Theme.copper; font-size: 12px; wrap: word-wrap; }
                            GhostButton { label: analysis-show-status ? "收起数据来源与状态" : "查看数据来源与状态"; clicked => { analysis-show-status = !analysis-show-status; } }
                            if analysis-show-status: PanelCard { VerticalBox { padding: 16px;
                                Text { text: analysis-overview; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            } }
                            PanelCard { VerticalBox { padding: 18px; spacing: 12px;
                                HorizontalBox { spacing: 10px;
                                    Text { text: "每日趋势"; color: Theme.text; font-size: 17px; font-weight: 600; horizontal-stretch: 1; }
                                    ComboBox { width: 180px; model: ["账号 Token", "筛选消耗", "API 情景折算"];
                                        current-index <=> root.analysis-trend-mode; selected(value) => { val-chart-mode = self.current-index == 2 ? 1 : 0; root.update-analysis(); } }
                                }
                                Text { text: analysis-trend-mode == 1 ? "单位：" + analysis-unit + " · 使用下方消耗筛选" : "不适用模型、来源筛选 · UTC · 缺失日期显示 —"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                AnalysisChart { bars: analysis-trend-mode == 1 ? root.analysis-bars : root.val-bars; maximum: analysis-trend-mode == 1 ? root.analysis-max : root.val-max;
                                    selected(detail) => { analysis-detail = detail; } }
                                Text { text: "点击柱形查看数值，或展开下方逐日明细；今天可能未完整。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                GhostButton { label: analysis-show-table ? "收起逐日明细" : "展开逐日明细"; clicked => { analysis-show-table = !analysis-show-table; } }
                                if analysis-show-table: VerticalBox { spacing: 6px;
                                    Text { text: "日期（UTC）        账号 Token        筛选消耗"; color: Theme.muted; font-size: 12px; }
                                    for day in root.analysis-daily-rows: HorizontalBox { spacing: 10px;
                                        GhostButton { label: day.date; clicked => { analysis-detail = day.detail; } }
                                        Text { text: day.tokens; color: Theme.text; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                                        Text { text: day.usage; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                                    }
                                }
                            } }
                            PanelCard { VerticalBox { padding: 18px; spacing: 12px;
                                Text { text: "消耗来源与模型"; color: Theme.text; font-size: 17px; font-weight: 600; }
                                Text { text: "以下筛选只影响消耗趋势、排行与明细；不改变上方账号 Token、轮次、估值或本机聊天。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                ComboBox { model: ["按产品", "按模型", "按消耗来源", "模型与速度"]; current-index <=> root.analysis-group;
                                    selected(value) => { analysis-detail = ""; root.update-analysis(); } }
                                HorizontalBox { spacing: 10px;
                                    ComboBox { model: root.analysis-model-options; current-index <=> root.analysis-model-index;
                                        selected(value) => { analysis-model-filter = value; analysis-detail = ""; root.update-analysis(); } }
                                    ComboBox { enabled: root.analysis-group != 3; model: root.analysis-source-options; current-index <=> root.analysis-source-index;
                                        selected(value) => { analysis-source-filter = value; analysis-detail = ""; root.update-analysis(); } }
                                }
                                Text { text: analysis-rank-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                Text { text: analysis-usage-message; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                if analysis-consumption-rows.length == 0: Text { text: "暂无可展示的正消耗。零值、缺失日期与未提供的维度请查看逐日明细。"; color: Theme.copper; font-size: 12px; wrap: word-wrap; }
                                for item in root.analysis-consumption-rows: VerticalBox { spacing: 4px;
                                    GhostButton { label: item.name; horizontal-stretch: 1; clicked => { root.select-analysis-rank(item.name); } }
                                    Text { text: item.value; color: Theme.text; font-size: 11px; }
                                    Rectangle { height: 5px; background: Theme.line;
                                        Rectangle { width: parent.width * item.ratio; height: parent.height; background: Theme.series(0); }
                                    }
                                }
                                GhostButton { label: analysis-show-all ? "仅显示前六项" : "展开全部分类"; clicked => { analysis-show-all = !analysis-show-all; root.update-analysis(); } }
                            } }
                            if analysis-detail != "": PanelCard { VerticalBox { padding: 18px; spacing: 10px;
                                Text { text: "所选明细"; color: Theme.text; font-size: 15px; font-weight: 600; }
                                Text { text: analysis-detail; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                                GhostButton { label: "关闭明细"; clicked => { analysis-detail = ""; } }
                            } }
                            GhostButton { label: analysis-show-comparison ? "收起完整期间对比" : "查看完整期间对比"; clicked => { analysis-show-comparison = !analysis-show-comparison; } }
                            if analysis-show-comparison: PanelCard { VerticalBox { padding: 18px;
                                Text { text: analysis-comparison; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                            } }
                            GhostButton { label: analysis-show-valuation ? "收起 API 等价估值" : "查看 API 等价估值与价格依据"; clicked => { analysis-show-valuation = !analysis-show-valuation; } }
                        if analysis-show-valuation: PanelCard {
                            VerticalBox { padding: 20px; spacing: 14px;
                                Text { text: val-text.title; font-size: 16px; font-weight: 600; color: Theme.text; }
                                HorizontalBox { spacing: 18px;
                                    VerticalBox { horizontal-stretch: 1; spacing: 5px;
                                        Text { text: val-text.tokens; font-size: 12px; color: Theme.muted; }
                                        Text { text: val-total; font-size: 25px; font-weight: 600; color: Theme.text; overflow: elide; }
                                    }
                                    VerticalBox { horizontal-stretch: 1; spacing: 5px;
                                        Text { text: val-automatic ? tr-val-auto-value : val-text.value; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                        Text { text: val-cost; font-size: 25px; font-weight: 600; color: Theme.copper; overflow: elide; }
                                    }
                                }
                                Text { text: val-coverage; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                Text { text: val-message; font-size: 11px; color: Theme.copper; wrap: word-wrap; }
                                HorizontalBox { spacing: 10px;
                                    GhostButton { label: tr-val-auto; solid: val-automatic; clicked => { val-automatic = true; val-editing = false; root.update-analysis(); } }
                                    GhostButton { label: tr-val-manual; solid: !val-automatic; clicked => { val-automatic = false; root.update-analysis(); } }
                                }
                                if val-automatic: Text { text: val-auto-status; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                if val-automatic: VerticalBox { spacing: 12px;
                                    for row in val-model-rows: VerticalBox { spacing: 5px;
                                        HorizontalBox {
                                            Text { text: row.model; font-size: 12px; color: Theme.text; horizontal-stretch: 1; }
                                            Text { text: row.cost; font-size: 13px; color: Theme.copper; }
                                        }
                                        Text { text: row.detail; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                        Rectangle { height: 1px; background: Theme.line; }
                                    }
                                }
                                Text { text: "折算情景（手动选择，不代表实际计费档位）"; color: Theme.text; font-size: 12px; }
                                HorizontalBox { spacing: 12px;
                                    ComboBox { model: ["Standard", "Fast", "Ultrafast"]; current-index <=> root.val-speed-index; selected(value) => { root.change-price-scenario(); } }
                                    ComboBox { model: ["短上下文 ≤272K", "长上下文 >272K"]; current-index <=> root.val-context-index; selected(value) => { root.change-price-scenario(); } }
                                }
                                Text { text: val-basis; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                HorizontalBox { spacing: 12px;
                                    Text { visible: !val-automatic; text: val-text.model; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                    ComboBox { visible: !val-automatic; horizontal-stretch: 1; model: val-models; current-index <=> val-model-index; enabled: val-available; selected(value) => { root.select-valuation-model(self.current-index); } }
                                    GhostButton { label: val-text.configure; enabled: val-available; clicked => { root.begin-valuation(); } }
                                }
                                if val-error != "": Text { text: val-error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
                                if val-editing: VerticalBox { spacing: 12px;
                                    Rectangle { height: 1px; background: Theme.line; }
                                    Text { text: val-text.hint; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    HorizontalBox { spacing: 16px;
                                        VerticalBox { horizontal-stretch: 1; spacing: 5px; Text { text: val-text.input-ratio + " " + Math.round(val-input-percent) + "%"; font-size: 12px; color: Theme.muted; wrap: word-wrap; } Slider { minimum: 0; maximum: 100; value <=> val-input-percent; } }
                                        VerticalBox { horizontal-stretch: 1; spacing: 5px; Text { text: val-text.cache-ratio + " " + Math.round(val-cache-percent) + "%"; font-size: 12px; color: Theme.muted; wrap: word-wrap; } Slider { minimum: 0; maximum: 100; value <=> val-cache-percent; } }
                                    }
                                    HorizontalBox { spacing: 12px;
                                        GhostButton { label: val-text.apply; emphasis: true; clicked => { root.apply-valuation(); } }
                                        GhostButton { label: val-text.cancel; clicked => { val-editing = false; val-error = ""; } }
                                    }
                                }
                                Text { text: val-text.scope; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                GhostButton { label: val-text.source + " ↗"; clicked => { root.open-pricing(); } }
                            }
                        }

                            GhostButton { label: analysis-show-tools ? "收起轮次与工具榜单" : "查看轮次与工具榜单"; clicked => { analysis-show-tools = !analysis-show-tools; } }
                            if analysis-show-tools: VerticalBox { spacing: 16px;
                                RankingPanel { title: tr-product-activity; total: analysis-turn-total; subtitle: "账号期间轮次 · 不适用消耗筛选"; rows: analysis-activity-rows; message: analysis-activity-message; options: [tr-by-model, tr-by-client]; selection <=> root.analysis-activity-group; selected => { root.update-analysis(); } }
                                RankingPanel { title: tr-tool-activity; total: analysis-tool-total; subtitle: "已返回榜单调用量 · 非全部调用审计"; rows: analysis-tool-rows; message: analysis-tool-message; options: [tr-plugins, tr-skills]; selection <=> root.analysis-tool-group; selected => { root.update-analysis(); } }
                            }
                            GhostButton { label: analysis-show-history ? "收起 52 周与累计记录" : "查看 52 周与累计记录"; clicked => { analysis-show-history = !analysis-show-history; root.update-analysis(); } }
                            if analysis-show-history: VerticalBox { spacing: 12px;
                                Text { text: "历史与累计 · 独立于上方 7 / 30 天范围"; color: Theme.text; font-size: 15px; font-weight: 600; }
                                HorizontalBox { spacing: 8px;
                                    ActivityMetric { value: current-token-lifetime; label: "累计 Token"; }
                                    ActivityMetric { value: current-token-peak; label: "历史峰值日"; }
                                    ActivityMetric { value: current-token-longest; label: "历史最长会话"; }
                                }
                                HorizontalBox { spacing: 8px;
                                    ActivityMetric { value: current-token-streak; label: "当前连续使用"; }
                                    ActivityMetric { value: current-token-longest-streak; label: "历史最长连续天数"; }
                                }
                                PanelCard { VerticalBox { padding: 16px; spacing: 10px;
                                    Text { text: "过去 52 周 · 每日 Token · UTC"; color: Theme.text; font-size: 14px; }
                                    Rectangle { height: 22px;
                                        for month in root.analysis-heat-months: Text { text: month.label; x: month.column * parent.width / 52; color: Theme.muted; font-size: 9px; }
                                    }
                                    Rectangle { height: 110px;
                                        for cell[index] in root.analysis-heat-cells: Rectangle {
                                            x: Math.floor(index / 7) * parent.width / 52;
                                            y: Math.mod(index,7) * 15px; width: max(3px,parent.width / 52 - 3px); height: 11px;
                                            background: cell.intensity < 0 ? transparent : cell.intensity == 0 ? Theme.line : Theme.copper.with-alpha(0.25 + 0.75 * cell.intensity);
                                            border-width: cell.intensity < 0 ? 1px : 0px; border-color: Theme.line;
                                            accessible-role: button; accessible-label: cell.detail; accessible-action-default => { root.analysis-detail = cell.detail; }
                                            TouchArea { mouse-cursor: pointer; clicked => { root.analysis-detail = cell.detail; } }
                                        }
                                    }
                                    Text { text: "空心：未提供  ·  灰色：明确为零  ·  橙色由浅到深：少 → 多。点击日期查看数值。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    if analysis-detail != "": Text { text: analysis-detail; color: Theme.text; font-size: 11px; wrap: word-wrap; }
                                    HorizontalBox { spacing: 8px;
                                        GhostButton { label: "每周"; solid: activity-range == 1; clicked => { activity-range = 1; } }
                                        GhostButton { label: "累计"; solid: activity-range == 2; clicked => { activity-range = 2; } }
                                    }
                                    Rectangle { height: 90px;
                                        for value[index] in (activity-range == 2 ? root.current-token-cumulative : root.current-token-weekly): Rectangle {
                                            x: index * parent.width / 52; width: max(3px,parent.width / 52 - 3px); height: max(1px,value * 85px); y: parent.height - self.height;
                                            background: value > 0 ? Theme.ok : Theme.line;
                                        }
                                    }
                                    Text { text: "每周／累计为服务端历史记录概览；缺失周不推断为零。"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                } }
                        if current-token-lifetime != "": HorizontalBox {
                            height: 214px;
                            spacing: 12px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 14px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.line.with-alpha(0.78);
                                VerticalBox {
                                    padding: 14px;
                                    spacing: 8px;
                                    Text {
                                        text: tr-activity-insights;
                                        font-size: 10px;
                                        font-family: "Menlo";
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        color: Theme.text;
                                    }
                                    GridLayout {
                                        spacing-horizontal: 10px;
                                        spacing-vertical: 8px;
                                        Row {
                                            Text { text: tr-activity-fast-mode; font-size: 11px; color: Theme.muted; }
                                            Text { text: current-fast-mode; font-size: 12px; font-family: "Menlo"; color: Theme.text; horizontal-alignment: right; }
                                        }
                                        Row {
                                            Text { text: tr-activity-reasoning; font-size: 11px; color: Theme.muted; }
                                            Text { text: current-reasoning; font-size: 12px; font-family: "Menlo"; color: Theme.text; horizontal-alignment: right; overflow: elide; }
                                        }
                                        Row {
                                            Text { text: tr-activity-unique-skills; font-size: 11px; color: Theme.muted; }
                                            Text { text: current-unique-skills; font-size: 12px; font-family: "Menlo"; color: Theme.text; horizontal-alignment: right; }
                                        }
                                        Row {
                                            Text { text: tr-activity-total-skills; font-size: 11px; color: Theme.muted; }
                                            Text { text: current-total-skills; font-size: 12px; font-family: "Menlo"; color: Theme.text; horizontal-alignment: right; }
                                        }
                                        Row {
                                            Text { text: tr-activity-threads; font-size: 11px; color: Theme.muted; }
                                            Text { text: current-total-threads; font-size: 12px; font-family: "Menlo"; color: Theme.text; horizontal-alignment: right; }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1.35;
                                border-radius: 14px;
                                background: Theme.panel;
                                border-width: 1px;
                                border-color: Theme.line.with-alpha(0.78);
                                VerticalBox {
                                    padding: 14px;
                                    spacing: 6px;
                                    Text {
                                        text: tr-activity-top;
                                        font-size: 10px;
                                        font-family: "Menlo";
                                        font-weight: 700;
                                        letter-spacing: 1px;
                                        color: Theme.text;
                                    }
                                    for item in root.current-top-invocations: HorizontalBox {
                                        height: 27px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 42px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.elevated;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            Text {
                                                text: item.kind;
                                                font-size: 8px;
                                                font-family: "Menlo";
                                                color: Theme.copper;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        Text {
                                            text: item.name;
                                            font-size: 11px;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: item.count + " " + tr-activity-runs;
                                            font-size: 10px;
                                            font-family: "Menlo";
                                            color: Theme.muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                            }
                        }
                        if analysis-local-mode: VerticalBox { spacing: 16px;
                            Text { text: "按更新时间筛选本机聊天；Token 为整段聊天累计值，不是期间消耗。与账号云端数据分开，不将聊天数量当作完成任务数。"; color: Theme.copper; font-size: 12px; wrap: word-wrap; }
                            HorizontalBox { spacing: 10px;
                                ComboBox { model: ["全部本机记录", "创建账号匹配", "创建账号未知"]; current-index <=> root.local-scope;
                                    selected(value) => { local-page = 0; root.render-local-analysis(); } }
                                ComboBox { model: root.local-project-options; current-index <=> root.local-project-index;
                                    selected(value) => { local-project-filter = value; local-page = 0; root.render-local-analysis(); } }
                            }
                            Field { text <=> root.local-search; placeholder: "搜索聊天标题、项目路径或最后记录模型"; edited => { local-page = 0; root.render-local-analysis(); } }
                            Text { text: local-status; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                            if local-action-status != "": Text { text: local-action-status; color: Theme.copper; font-size: 12px; wrap: word-wrap; }
                            PanelCard { VerticalBox { padding: 18px; spacing: 10px;
                                ComboBox { model: ["按项目统计记录数", "按最后记录模型", "按手动用途标签"]; current-index <=> root.local-group; selected(value) => { root.render-local-analysis(); } }
                                Text { text: local-summary; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                            } }
                            for chat in root.local-rows: PanelCard { VerticalBox { padding: 14px; spacing: 7px;
                                Text { text: chat.title; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                                Text { text: chat.detail; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                HorizontalBox { spacing: 10px;
                                    Text { text: "聊天累计 Token " + chat.tokens + " · 用途 " + chat.tag; color: Theme.text; font-size: 11px; wrap: word-wrap; horizontal-stretch: 1; }
                                    GhostButton { label: "明细 / 标签"; clicked => { root.select-local-chat(chat.id); } }
                                }
                            } }
                            HorizontalBox { spacing: 10px;
                                GhostButton { label: "上一页"; enabled: local-page > 0; clicked => { local-page -= 1; root.render-local-analysis(); } }
                                Text { text: (local-page + 1) + " / " + local-page-count; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                GhostButton { label: "下一页"; enabled: local-page + 1 < local-page-count; clicked => { local-page += 1; root.render-local-analysis(); } }
                            }
                            PanelCard { VerticalBox { padding: 18px; spacing: 10px;
                                Text { text: local-detail; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                                if local-selected: Field { text <=> root.local-tag; placeholder: "手动用途标签（40 字以内，留空清除）"; }
                                if local-selected: GhostButton { label: "保存手动标签"; clicked => { root.save-local-tag(); } }
                            } }
                        }
                    }
                }
            }
        }
        Rectangle { height: 30px; background: Theme.panel;
            HorizontalBox { padding-left: 18px; padding-right: 18px;
                Text { text: status-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: provider-index == 0 ? "CODEX" : "CLAUDE DESKTOP"; font-size: 10px; color: Theme.faint; vertical-alignment: center; }
            }
        }
    }

    if backup-open: Rectangle {
        z: 110; background: #00000099;
        TouchArea {}
        Rectangle {
            width: min(640px, parent.width - 48px); height: min(backup-rows.length > 0 ? 530px : 340px, parent.height - 60px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.panel; border-radius: 14px; border-width: 1px; border-color: Theme.line;
            TouchArea {}
            VerticalBox { padding: 22px; spacing: 14px;
                Text { text: backup-heading; color: Theme.text; font-size: 20px; font-weight: 600; }
                Text { text: backup-message; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                ScrollView { vertical-stretch: 1;
                    VerticalBox { spacing: 7px; padding: 4px; alignment: start;
                        for row in backup-rows: Text { text: row; color: Theme.text; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; min-height: 24px; }
                    }
                }
                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton { label: backup-ready ? tr-rename-cancel : tr-about-close; clicked => { root.cancel-backup(); } }
                    if backup-ready: GhostButton { label: backup-confirm-label; emphasis: true; clicked => { root.confirm-backup(); } }
                }
            }
        }
    }

    if show-about: Rectangle {
        z: 100;
        background: #00000099;
        TouchArea { clicked => { show-about = false; } }
        Rectangle {
            width: 620px;
            height: 452px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: Theme.elevated;
            border-width: 1px;
            border-color: Theme.line.with-alpha(0.92);
            TouchArea {}
            VerticalBox {
                padding: 22px;
                spacing: 11px;

                HorizontalBox {
                    spacing: 10px;
                    Rectangle {
                        width: 5px;
                        height: 26px;
                        border-radius: 3px;
                        background: Theme.copper;
                    }
                    Text {
                        text: "GCSA · " + app-version;
                        font-size: 19px;
                        font-weight: 700;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: tr-about-description;
                    height: 62px;
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                Rectangle { height: 1px; background: Theme.line; }

                Text {
                    text: tr-about-third-party;
                    font-size: 10px;
                    font-family: "Menlo";
                    font-weight: 700;
                    letter-spacing: 1px;
                    color: Theme.copper;
                }

                Rectangle {
                    height: 120px;
                    border-radius: 10px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line.with-alpha(0.78);
                    AboutSlint {
                        x: (parent.width - self.width) / 2;
                        width: 300px;
                        height: parent.height;
                    }
                }

                Text {
                    text: "Slint 1.17.1  ·  LicenseRef-Slint-Royalty-free-2.0  ·  https://slint.dev";
                    height: 20px;
                    font-size: 10px;
                    font-family: "Menlo";
                    color: Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                Text {
                    text: tr-about-notices;
                    height: 38px;
                    font-size: 10px;
                    color: Theme.muted;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                HorizontalBox {
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton {
                        label: tr-about-close;
                        solid: true;
                        clicked => { show-about = false; }
                    }
                }
            }
        }
    }
}
