import { AboutSlint, ScrollView, VerticalBox, HorizontalBox, ComboBox, Palette, Slider } from "std-widgets.slint";

export struct ValLabels {
    title: string,
    tokens: string,
    value: string,
    configure: string,
    model: string,
    custom: string,
    input-ratio: string,
    cache-ratio: string,
    input-price: string,
    cache-price: string,
    output-price: string,
    price-date: string,
    apply: string,
    cancel: string,
    trend: string,
    token-mode: string,
    cost-mode: string,
    scope: string,
    source: string,
    hint: string,
}

export struct AccountRow {
    quota-details: string,
    quota-stale: bool,
    alias: string,
    email: string,
    plan: string,
    account_id: string,
    is_current: bool,
    is_valid: bool,
    primary_pct: float,
    secondary_pct: float,
    primary_reset: string,
    secondary_reset: string,
    primary_available: bool,
    secondary_available: bool,
    credits: string,
    reset_credits: string,
    usage_summary: string,
    reset_summary: string,
    recommendation: string,
    usage_updated: string,
    usage_attention: bool,
    usage_error: string,
}

export struct ActivityInvocation {
    name: string,
    kind: string,
    count: string,
}

// Dark control-room palette: quiet surfaces, warm focus, restrained borders.
global Theme {
    public pure function series(index: int) -> color { return [#70A3F3, #78CDB1, #DAB16D, #CB95CF, #ABAAF0, #B2B9C4][Math.mod(index,6)]; }
    out property <color> bg: #12151A;
    out property <color> panel: #1B1F26;
    out property <color> elevated: #242A33;
    out property <color> surface: #2B323D;
    out property <color> line: #303640;
    out property <color> text: #F0F4F8;
    out property <color> muted: #A3ADBB;
    out property <color> faint: #84909E;
    out property <color> copper: #D99328;
    out property <color> copper-dim: #B98234;
    out property <color> danger: #F06B55;
    out property <color> ok: #72C1A8;
}

export component AppTray inherits SystemTrayIcon {
    in-out property <string> tray-tooltip <=> root.tooltip;
    in-out property <string> tray-title <=> root.title;
    in-out property <bool> tray-visible <=> root.visible;
    in property <[AccountRow]> accounts: [];

    icon: @image-url("../assets/tray-icon.png");
    tooltip: "Codex Account Switch";
    title: "Codex";

    in-out property <string> tr-tray-refresh: "Refresh Usage";
    in-out property <string> tr-tray-switch: "Switch Account";
    in-out property <string> tr-tray-show: "Show Window";
    in-out property <string> tr-tray-quit: "Quit";

    callback refresh-usage();
    callback switch-account(string);
    callback show-window();
    callback quit();

    Menu {
        MenuItem {
            title: tr-tray-show;
            activated => { show-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: tr-tray-refresh;
            activated => { refresh-usage(); }
        }
        MenuSeparator {}
        Menu {
            title: tr-tray-switch;
            for acc in root.accounts: MenuItem {
                title: (acc.is_current ? "✓ " : "   ") + acc.alias + (acc.plan == "" ? "" : " · " + acc.plan);
                enabled: acc.is_valid && !acc.is_current;
                activated => { switch-account(acc.alias); }
            }
        }
        MenuSeparator {}
        MenuItem {
            title: tr-tray-quit;
            activated => { quit(); }
        }
    }
}



component ActivityMetric inherits Rectangle {
    in property <string> value;
    in property <string> label;

    height: 72px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Theme.elevated.with-alpha(0.58);
    border-width: 1px;
    border-color: Theme.line.with-alpha(0.72);

    VerticalBox {
        padding: 10px;
        spacing: 3px;
        alignment: center;
        Text {
            text: value == "" ? "—" : value;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: label;
            font-size: 9px;
            font-family: "Menlo";
            color: Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasis: false;
    in property <bool> danger: false;
    in property <bool> solid: false; // stronger filled secondary action
    in property <length> btn-height: 32px;
    in-out property <bool> enabled <=> touch.enabled;
    callback clicked();

    forward-focus: key-focus;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    private property <bool> hot: enabled && (touch.has-hover || touch.pressed);
    private property <bool> down: enabled && touch.pressed;

    height: btn-height;
    min-width: max(72px, button-layout.min-width);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    background: !enabled ? Theme.elevated.with-alpha(0.35)
        : down ? (emphasis || solid ? Theme.copper-dim : Theme.copper.with-alpha(0.35))
        : emphasis ? Theme.copper
        : danger ? Theme.danger.with-alpha(hot ? 0.14 : 0.07)
        : solid ? Theme.elevated.with-alpha(0.82)
        : hot ? Theme.copper.with-alpha(0.18)
        : transparent;
    border-width: (emphasis && !down) ? 0px : 1px;
    border-color: !enabled ? Theme.line
        : down ? Theme.copper
        : danger ? Theme.danger.with-alpha(hot ? 0.58 : 0.18)
        : hot ? Theme.copper.with-alpha(0.65)
        : Theme.line;

    button-layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: center;
        Text {
            text: label;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
            color: !enabled ? Theme.faint
                : emphasis ? #1A140C
                : danger && !hot ? Theme.danger
                : down || hot ? Theme.copper
                : Theme.text;
        }
    }

    key-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}



component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted();
    callback edited();

    height: 36px;
    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.copper.with-alpha(0.65) : Theme.line;

    if text == "": Text {
        x: 12px;
        y: 10px;
        text: placeholder;
        font-size: 12px;
        font-family: "Menlo";
        color: Theme.faint;
    }

    edit := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text <=> root.text;
        font-size: 12px;
        font-family: "Menlo";
        color: Theme.text;
        selection-background-color: Theme.copper.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        single-line: true;
        vertical-alignment: center;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
}

component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> area-height: 96px;

    height: area-height;
    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.copper.with-alpha(0.65) : Theme.line;

    if text == "": Text {
        x: 12px;
        y: 10px;
        text: placeholder;
        font-size: 11px;
        font-family: "Menlo";
        color: Theme.faint;
        wrap: word-wrap;
        width: parent.width - 24px;
    }

    edit := TextInput {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        text <=> root.text;
        font-size: 11px;
        font-family: "Menlo";
        color: Theme.text;
        selection-background-color: Theme.copper.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        single-line: false;
        wrap: word-wrap;
    }
}

export struct AnalysisSegment { fraction: float, offset: float, color-index: int }
export struct AnalysisBar { label: string, detail: string, segments: [AnalysisSegment] }
export struct AnalysisLegend { name: string, color-index: int }
export struct HistoryRow { title: string, time: string }
export struct ValuationRow { model: string, detail: string, cost: string }
export struct AnalysisRank { name: string, value: string, ratio: float }

export struct AnalysisDayRow { date: string, tokens: string, usage: string, detail: string }
export struct AnalysisHeatCell { intensity: float, detail: string }
export struct AnalysisHeatMonth { label: string, column: int }
export struct LocalChatRow { id: string, title: string, detail: string, tokens: string, tag: string }

component AnalysisChart inherits Rectangle {
    in property <[AnalysisBar]> bars;
    in property <string> maximum;
    callback selected(string);
    height: 200px;
    Text { text: root.maximum; color: Theme.muted; font-size: 10px; x: 0px; y: 0px; }
    Text { text: "0"; color: Theme.muted; font-size: 10px; x: 0px; y: parent.height - 34px; }
    HorizontalBox { padding-left: 76px; spacing: root.bars.length <= 7 ? 10px : 2px;
        for bar in root.bars: cell := Rectangle {
            horizontal-stretch: 1;
            accessible-role: button; accessible-label: bar.detail;
            accessible-action-default => { root.selected(bar.detail); }
            forward-focus: bar-focus;
            border-width: bar-focus.has-focus ? 1px : 0px; border-color: Theme.copper;
            if bar.segments.length == 0: Text { text: "—"; y: parent.height - 48px; width: parent.width; color: Theme.muted; horizontal-alignment: center; }
            for segment in bar.segments: Rectangle {
                x: parent.width * 0.08; width: parent.width * 0.84;
                y: 20px + (parent.height - 54px) * (1 - segment.offset - segment.fraction);
                height: max(0px, (parent.height - 54px) * segment.fraction);
                background: Theme.series(segment.color-index);
            }
            Text { text: bar.label; y: parent.height - 24px; width: parent.width; horizontal-alignment: center; color: Theme.muted; font-size: 10px; }
            bar-focus := FocusScope { key-pressed(e) => { if e.text == " " || e.text == "\n" { root.selected(bar.detail); return accept; } return reject; } }
            TouchArea { mouse-cursor: pointer; clicked => { root.selected(bar.detail); } }
        }
    }
}


component PageHeader inherits HorizontalBox {
    in property <string> heading;
    in property <string> subtitle;
    spacing: 10px;
    VerticalBox { spacing: 4px; horizontal-stretch: 1;
        Text { text: heading; font-size: 25px; font-weight: 600; color: Theme.text; }
        Text { text: subtitle; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
    }
    @children
}

component PanelCard inherits Rectangle {
    vertical-stretch: 0;
    background: Theme.panel;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.line;
    @children
}

component RankingPanel inherits Rectangle {
    in property <string> title;
    in property <string> total;
    in property <string> subtitle;
    in property <string> message;
    in property <[AnalysisRank]> rows;
    in property <[string]> options;
    in-out property <int> selection;
    callback selected();
    min-width: 250px;
    height: 472px;
    background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.line;
    VerticalBox {
        padding: 18px; spacing: 10px; alignment: start;
        HorizontalBox {
            Text { text: root.title; font-size: 16px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
            ComboBox { width: 110px; horizontal-stretch: 0; model: root.options; current-index <=> root.selection; selected(value) => { root.selected(); } }
        }
        HorizontalBox {
            Text { text: root.subtitle; font-size: 11px; color: Theme.muted; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center; }
            Text { text: root.total; font-size: 26px; font-weight: 600; color: Theme.text; }
        }
        Text { text: root.message; color: Theme.muted; font-size: 11px; wrap: word-wrap; min-height: 30px; }
        for row in root.rows: VerticalBox {
            spacing: 7px; height: 36px;
            HorizontalBox { spacing: 6px;
                Text { text: row.name; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                Text { text: row.value; color: Theme.text; font-size: 12px; }
            }
            Rectangle { height: 5px; background: Theme.line; border-radius: 3px;
                Rectangle { x: 0px; y: 0px; width: parent.width * row.ratio; height: parent.height; background: Theme.series(0); border-radius: 3px; }
            }
        }
    }
}

