    in-out property <string> current-fast-mode: "";
    in-out property <string> current-reasoning: "";
    in-out property <string> current-unique-skills: "";
    in-out property <string> current-total-skills: "";
    in-out property <string> current-total-threads: "";
    in-out property <[ActivityInvocation]> current-top-invocations: [];
    in-out property <bool> current-primary-available: false;
    in-out property <bool> current-secondary-available: false;
    in-out property <string> save-alias: "";
