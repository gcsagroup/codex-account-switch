import { AboutSlint, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct AccountRow {
    alias: string,
    email: string,
    plan: string,
    account_id: string,
    is_current: bool,
    is_valid: bool,
    primary_pct: float,
    secondary_pct: float,
    primary_reset: string,
    secondary_reset: string,
    primary_available: bool,
    secondary_available: bool,
    credits: string,
    usage_summary: string,
    usage_updated: string,
    usage_attention: bool,
    usage_error: string,
}

export struct ActivityInvocation {
    name: string,
    kind: string,
    count: string,
}

// Dark control-room palette: quiet surfaces, warm focus, restrained borders.
global Theme {
    out property <color> bg: #0F141B;
    out property <color> panel: #151D27;
    out property <color> elevated: #1D2835;
    out property <color> surface: #222F3E;
    out property <color> line: #2B3949;
    out property <color> text: #F0F4F8;
    out property <color> muted: #93A1B3;
    out property <color> faint: #607084;
    out property <color> copper: #E2A344;
    out property <color> copper-dim: #B98234;
    out property <color> danger: #F06B55;
    out property <color> ok: #72C1A8;
}

export component AppTray inherits SystemTrayIcon {
    in-out property <string> tray-tooltip <=> root.tooltip;
    in-out property <string> tray-title <=> root.title;
    in-out property <bool> tray-visible <=> root.visible;
    in property <[AccountRow]> accounts: [];

    icon: @image-url("../assets/tray-icon.png");
    tooltip: "Codex Account Switch";
    title: "Codex";

    in-out property <string> tr-tray-refresh: "Refresh Usage";
    in-out property <string> tr-tray-switch: "Switch Account";
    in-out property <string> tr-tray-show: "Show Window";
    in-out property <string> tr-tray-quit: "Quit";

    callback refresh-usage();
    callback switch-account(string);
    callback show-window();
    callback quit();

    Menu {
        MenuItem {
            title: tr-tray-show;
            activated => { show-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: tr-tray-refresh;
            activated => { refresh-usage(); }
        }
        MenuSeparator {}
        Menu {
            title: tr-tray-switch;
            for acc in root.accounts: MenuItem {
                title: (acc.is_current ? "✓ " : "   ") + acc.alias + (acc.plan == "" ? "" : " · " + acc.plan);
                enabled: acc.is_valid && !acc.is_current;
                activated => { switch-account(acc.alias); }
            }
        }
        MenuSeparator {}
        MenuItem {
            title: tr-tray-quit;
            activated => { quit(); }
        }
    }
}

component Gauge inherits Rectangle {
    in property <string> label;
    in property <float> percent;
    in property <string> reset-text;
    in property <bool> available: true;
    height: 68px;
    border-radius: 9px;
    background: Theme.bg.with-alpha(0.52);
    border-width: 1px;
    border-color: Theme.line.with-alpha(0.72);

    VerticalBox {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        HorizontalBox {
            Text {
                text: label;
                font-size: 10px;
                font-family: "Menlo";
                color: Theme.muted;
                letter-spacing: 0.8px;
                horizontal-stretch: 1;
            }
            Text {
                text: available ? Math.round(percent) + "%" : "—";
                font-size: 12px;
                font-weight: 700;
                font-family: "Menlo";
                color: !available ? Theme.faint : (percent >= 90 ? Theme.danger : Theme.copper);
            }
        }

        Rectangle {
            height: 5px;
            border-radius: 3px;
            background: Theme.line;
            Rectangle {
                x: 0px;
                width: root.available ? parent.width * Math.min(1.0, Math.max(0.0, root.percent / 100)) : 0px;
                height: parent.height;
                border-radius: 3px;
                background: root.percent >= 90 ? Theme.danger : (root.percent >= 70 ? Theme.copper-dim : Theme.copper);
            }
        }

        Text {
            text: reset-text;
            font-size: 9px;
            font-family: "Menlo";
            color: Theme.faint;
            overflow: elide;
        }
    }
}

component PlanBadge inherits Rectangle {
    in property <string> label;

    height: 20px;
    min-width: max(48px, badge-layout.min-width);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 10px;
    background: Theme.copper.with-alpha(0.14);
    border-width: 1px;
    border-color: Theme.copper.with-alpha(0.22);

    badge-layout := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 2px;
        padding-bottom: 2px;
        alignment: center;

        Text {
            text: label;
            font-size: 10px;
            font-family: "Menlo";
            font-weight: 700;
            color: Theme.copper;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ActivityMetric inherits Rectangle {
    in property <string> value;
    in property <string> label;

    height: 72px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Theme.elevated.with-alpha(0.58);
    border-width: 1px;
    border-color: Theme.line.with-alpha(0.72);

    VerticalBox {
        padding: 10px;
        spacing: 3px;
        alignment: center;
        Text {
            text: value == "" ? "—" : value;
            font-size: 16px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: label;
            font-size: 9px;
            font-family: "Menlo";
            color: Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> emphasis: false;
    in property <bool> danger: false;
    in property <bool> solid: false; // stronger filled secondary action
    in property <length> btn-height: 32px;
    in-out property <bool> enabled <=> touch.enabled;
    callback clicked();

    forward-focus: key-focus;
    accessible-role: button;
    accessible-enabled: enabled;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    private property <bool> hot: enabled && (touch.has-hover || touch.pressed);
    private property <bool> down: enabled && touch.pressed;

    height: btn-height;
    min-width: max(72px, button-layout.min-width);
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    background: !enabled ? Theme.elevated.with-alpha(0.35)
        : down ? (emphasis || solid ? Theme.copper-dim : Theme.copper.with-alpha(0.35))
        : emphasis ? Theme.copper
        : danger ? Theme.danger.with-alpha(hot ? 0.14 : 0.07)
        : solid ? Theme.elevated.with-alpha(0.82)
        : hot ? Theme.copper.with-alpha(0.18)
        : transparent;
    border-width: (emphasis && !down) ? 0px : 1px;
    border-color: !enabled ? Theme.line
        : down ? Theme.copper
        : danger ? Theme.danger.with-alpha(hot ? 0.58 : 0.18)
        : hot ? Theme.copper.with-alpha(0.65)
        : Theme.line;

    button-layout := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: center;
        Text {
            text: label;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
            color: !enabled ? Theme.faint
                : emphasis ? #1A140C
                : danger && !hot ? Theme.danger
                : down || hot ? Theme.copper
                : Theme.text;
        }
    }

    key-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component UsageChip inherits Rectangle {
    in property <string> label;
    in property <float> percent;
    in property <string> reset-text;
    in property <string> reset-label;
    in property <bool> attention: false;

    height: 38px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 9px;
    background: attention ? Theme.danger.with-alpha(0.10) : Theme.bg.with-alpha(0.68);
    border-width: 1px;
    border-color: attention ? Theme.danger.with-alpha(0.42) : Theme.line.with-alpha(0.82);

    Text {
        x: 14px;
        y: 0px;
        width: parent.width - 214px;
        height: parent.height;
        text: reset-label + " " + reset-text;
        font-size: 11px;
        font-family: "Menlo";
        font-weight: 700;
        color: attention ? Theme.danger : Theme.muted;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 186px;
        y: 0px;
        width: 100px;
        height: parent.height;
        text: label;
        font-size: 11px;
        font-weight: 700;
        color: attention ? Theme.danger : Theme.muted;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 78px;
        y: 0px;
        width: 64px;
        height: parent.height;
        text: Math.round(percent) + "%";
        font-size: 16px;
        font-weight: 700;
        font-family: "Menlo";
        color: attention ? Theme.danger : Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component LanguageOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    background: selected ? Theme.copper.with-alpha(0.18) : (option-touch.has-hover ? Theme.panel : transparent);

    option-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: label;
        font-size: 11px;
        font-family: "Menlo";
        color: selected ? Theme.copper : Theme.text;
        vertical-alignment: center;
        x: 10px;
    }
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback accepted();

    height: 36px;
    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.copper.with-alpha(0.65) : Theme.line;

    if text == "": Text {
        x: 12px;
        y: 10px;
        text: placeholder;
        font-size: 12px;
        font-family: "Menlo";
        color: Theme.faint;
    }

    edit := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text <=> root.text;
        font-size: 12px;
        font-family: "Menlo";
        color: Theme.text;
        selection-background-color: Theme.copper.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        single-line: true;
        vertical-alignment: center;
        accepted => { root.accepted(); }
    }
}

component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> area-height: 96px;

    height: area-height;
    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.copper.with-alpha(0.65) : Theme.line;

    if text == "": Text {
        x: 12px;
        y: 10px;
        text: placeholder;
        font-size: 11px;
        font-family: "Menlo";
        color: Theme.faint;
        wrap: word-wrap;
        width: parent.width - 24px;
    }

    edit := TextInput {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        text <=> root.text;
        font-size: 11px;
        font-family: "Menlo";
        color: Theme.text;
        selection-background-color: Theme.copper.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        single-line: false;
        wrap: word-wrap;
    }
}

export component MainWindow inherits Window {
    title: "Codex Account Switch";
    preferred-width: 860px;
    preferred-height: 720px;
    min-width: 780px;
    min-height: 480px;
    background: Theme.bg;

    in-out property <[AccountRow]> accounts: [];
    in-out property <string> status-text: "Ready";
    in-out property <string> active-alias: "";
    in-out property <string> current-alias: "";
    in-out property <string> current-email: "";
    in-out property <string> current-plan: "";
    in-out property <float> current-primary: 0;
    in-out property <float> current-secondary: 0;
    in-out property <string> current-primary-reset: "—";
    in-out property <string> current-secondary-reset: "—";
    in-out property <string> current-credits: "";
    in-out property <string> current-token-lifetime: "";
    in-out property <string> current-token-peak: "";
    in-out property <string> current-token-streak: "";
    in-out property <string> current-token-longest: "";
    in-out property <[float]> current-token-trend: [];
    in-out property <string> current-token-week: "";
    in-out property <string> current-token-longest-streak: "";
